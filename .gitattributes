# Line endings normalised to LF in the repository, whatever the working OS.
* text=auto eol=lf

# Binary files: no conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.db binary

# The lockfile is generated: keep it out of review diffs.
bun.lock linguist-generated=true
