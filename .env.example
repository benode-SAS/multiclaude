# Copy to .env at the repository root. Loaded through --env-file by the bun scripts.
# Every value is optional: what is shown here is the default.

# --- Server ----------------------------------------------------------------
PORT=8000
# Origins allowed by CORS. Pointless when SERVE_WEB=true (same origin).
# CORS_ORIGIN=https://multiclaude.example.com

# Serves the built front from the server: one port, no CORS, same-origin WS.
# On by default as soon as apps/web/dist exists ("bun run build").
# Set to false to serve the front some other way (vite, nginx, another host).
# SERVE_WEB=true
# WEB_DIST=apps/web/dist

# --- Data ------------------------------------------------------------------
# SQLite + the rooms' working directories. Relative to the repository root, or
# an absolute path. This is the only directory to back up or mount as a volume.
DATA_DIR=data

# --- Accounts and sessions -------------------------------------------------
# Public URL of the instance. Used by session cookies and trusted origins: over
# https, the cookie automatically becomes `secure`.
# PUBLIC_URL=https://multiclaude.example.com

# Extra origins allowed to open a session, comma separated. Pointless as long as
# the front is served from the same origin.
# TRUSTED_ORIGINS=https://other-domain.example.com

# Session signing key. When absent, one is generated in DATA_DIR/.auth-secret —
# changing it signs everyone out.
# AUTH_SECRET=

# The public signup form. Closed, an admin creates accounts from the interface
# or with "bun run cli users add", handing out a temporary password. The very
# first account stays creatable from the welcome screen either way, or a fresh
# instance would be unusable. Adjustable afterwards from the admin panel, which
# takes precedence over this value.
SIGNUP_ENABLED=true

# Creates this admin account at boot when no account exists yet. Handy in a
# container, where nobody is around to fill in the form.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Admin

# --- Claude Code -----------------------------------------------------------
# The claude binary. Resolved from the PATH by default.
# CLAUDE_BIN=/usr/local/bin/claude

# Where the CLI stores its OAuth credentials. On a server, pointing it inside
# DATA_DIR makes the deployment self-contained and survives container restarts.
CLAUDE_CONFIG_DIR=data/claude

# Permissions are decided per command (apps/server/src/agent/policy.ts): grep,
# python, curl, npm, git commit… run unattended; sudo, pg_dump, rm outside the
# working directory, git push, docker, kill, reaching for secrets… ask first.
#
# Force some tools to always ask, whatever the command is.
# e.g. ALWAYS_ASK_TOOLS=Bash,WebFetch
ALWAYS_ASK_TOOLS=

# Extra patterns (case-insensitive regexes) that also trigger a confirmation.
# e.g. ASK_PATTERNS=prod,deploy\.sh,\.env\.production
ASK_PATTERNS=

# How long (seconds) the hook waits for a human answer before giving up.
PERMISSION_TIMEOUT=900

# Claude setting sources loaded by the agent (user,project,local). Empty means
# the agent inherits no CLAUDE.md and no setting from the host machine.
SETTING_SOURCES=

# Instructions appended to the CLI's system prompt (tone, language, brevity).
# Leave empty to append nothing. Default: see src/config.ts
# APPEND_SYSTEM_PROMPT=Answer briefly.

# --- Repository cloning ----------------------------------------------------
# Clone depth when creating a room. 0 for the full history.
CLONE_DEPTH=1
# Give up past this delay, in seconds.
CLONE_TIMEOUT=180

# Private repositories, two possible routes:
#
# 1. A token typed in the creation dialog: used for the clone, then forgotten
#    (the remote is reset to the credential-free URL). Nothing to set here.
#
# 2. This default token, when nobody types one. Handy on a team instance with a
#    single read-only service account. It is not passed to the agent, which
#    could otherwise read it out of its own environment.
# GIT_TOKEN=

# SSH key for git@… URLs (the server's deploy key). Defaults to the ssh
# configuration of the user running the server.
# GIT_SSH_KEY=/home/multiclaude/.ssh/id_ed25519

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_MB=50

# --- Front (development only) ----------------------------------------------
WEB_PORT=3000
# WEB_HOST=0.0.0.0
# Target of the vite proxy. Defaults to http://localhost:$PORT
# API_URL=http://localhost:8000
