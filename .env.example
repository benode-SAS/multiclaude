# Copier en .env à la racine. Chargé via --env-file par les scripts bun.
# Toutes les valeurs sont optionnelles : ce sont les défauts qui sont indiqués.

# --- Serveur ---------------------------------------------------------------
PORT=8000
# Origines autorisées en CORS. Inutile si SERVE_WEB=true (même origine).
# CORS_ORIGIN=https://multiclaude.interne.benode.fr

# Sert le front buildé depuis le serveur : un seul port, pas de CORS, WS same-origin.
# Nécessite "bun run build" au préalable.
SERVE_WEB=false
# WEB_DIST=apps/web/dist

# --- Données ---------------------------------------------------------------
# SQLite + workdirs des rooms. Relatif à la racine du repo, ou chemin absolu.
# C'est le seul dossier à sauvegarder / monter en volume.
DATA_DIR=data

# --- Claude Code -----------------------------------------------------------
# Binaire claude. Par défaut résolu depuis le PATH.
# CLAUDE_BIN=/usr/local/bin/claude

# Où le CLI stocke ses credentials OAuth. Sur un serveur, le pointer dans DATA_DIR
# rend le déploiement autonome et survit aux redémarrages du conteneur.
CLAUDE_CONFIG_DIR=data/claude

# Les permissions sont décidées par commande (apps/server/src/agent/policy.ts) :
# grep, python, curl, npm, git commit… passent seuls ; sudo, pg_dump, rm hors
# workdir, git push, docker, kill, accès aux secrets… demandent un clic.
#
# Force certains outils à toujours demander, quelle que soit la commande.
# Ex. ALWAYS_ASK_TOOLS=Bash,WebFetch
ALWAYS_ASK_TOOLS=

# Motifs (regex, insensibles à la casse) qui déclenchent en plus une demande.
# Ex. ASK_PATTERNS=prod,deploy\.sh,\.env\.production
ASK_PATTERNS=

# Délai max (secondes) d'attente d'une réponse humaine avant que le hook lâche.
PERMISSION_TIMEOUT=900

# Sources de settings Claude chargées par l'agent (user,project,local).
# Vide = l'agent n'hérite d'aucun CLAUDE.md / réglage de la machine hôte.
SETTING_SOURCES=

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_MB=50

# --- Front (dev uniquement) -----------------------------------------------
WEB_PORT=3000
# WEB_HOST=0.0.0.0
# Cible du proxy vite. Par défaut http://localhost:$PORT
# API_URL=http://localhost:8000
