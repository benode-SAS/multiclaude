{
	"name": "multiclaude",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun run --filter '*' dev",
		"build": "bun run --filter '*' build",
		"typecheck": "bun run --filter '*' typecheck",
		"check": "biome check .",
		"fix": "biome check --write .",
		"db:generate": "bun run --filter @multiclaude/server db:generate",
		"db:migrate": "bun run --filter @multiclaude/server db:migrate"
	},
	"devDependencies": {
		"@biomejs/biome": "latest",
		"typescript": "latest"
	}
}
