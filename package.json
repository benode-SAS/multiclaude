{
	"name": "multiclaude",
	"private": true,
	"type": "module",
	"description": "Chat multi-utilisateur temps réel au-dessus de Claude Code",
	"author": "Benode SAS (https://www.benode.fr)",
	"license": "MIT",
	"homepage": "https://github.com/benode-SAS/multiclaude",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/benode-SAS/multiclaude.git"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun run --filter '*' dev",
		"build": "bun run --filter '*' build",
		"start": "bun run --filter @multiclaude/server start",
		"deploy": "bun install && bun run build && bun run db:migrate",
		"typecheck": "bun run --filter '*' typecheck",
		"check": "biome check .",
		"fix": "biome check --write .",
		"db:generate": "bun run --filter @multiclaude/server db:generate",
		"db:migrate": "bun run --filter @multiclaude/server db:migrate",
		"cli": "bun run --filter @multiclaude/server cli --",
		"test": "bun run --filter '*' test"
	},
	"devDependencies": {
		"@biomejs/biome": "latest",
		"typescript": "latest"
	}
}
