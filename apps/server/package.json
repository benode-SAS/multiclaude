		"db:migrate": "bun src/db/migrate.ts"
	},
	"dependencies": {
		"@elysiajs/cors": "latest",
		"@multiclaude/shared": "workspace:*",
		"drizzle-orm": "latest",
		"elysia": "latest",
		"nanoid": "latest"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"drizzle-kit": "latest"
	}
}
