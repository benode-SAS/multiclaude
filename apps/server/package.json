{
	"name": "@multiclaude/server",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --env-file=../../.env --watch src/index.ts",
		"start": "bun --env-file=../../.env src/index.ts",
		"typecheck": "tsc --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun --env-file=../../.env src/db/migrate.ts",
		"test": "bun test"
	},
	"dependencies": {
		"@elysiajs/cors": "latest",
		"@elysiajs/static": "^1.4.10",
		"@multiclaude/shared": "workspace:*",
		"better-auth": "^1.6.25",
		"drizzle-orm": "latest",
		"elysia": "latest",
		"nanoid": "latest"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"drizzle-kit": "latest"
	}
}
